# -----------------------------------------------------------------------
# Example .env-local file for running multiple Superset instances
# Copy this file to .env-local and customize for your setup
# -----------------------------------------------------------------------

# Unique project name prevents container/volume conflicts between clones
# Each clone should have a different name (e.g., superset-pr123, superset-feature-x)
COMPOSE_PROJECT_NAME=superset-dev2

# Port offsets for running multiple instances simultaneously
# Instance 1 (default): 80, 8088, 9000, 8080, 8081, 5432, 6379
# Instance 2 example:   81, 8089, 9001, 8082, 8083, 5433, 6380
NGINX_PORT=81
SUPERSET_PORT=8089
NODE_PORT=9001
WEBSOCKET_PORT=8082
DATABASE_PORT=5433
REDIS_PORT=6380

# For verbose logging during development:
# SUPERSET_LOG_LEVEL=debug

# ---- Briefing Feishu (Lark) push -----------------------------------------
# Custom app credentials for pushing briefings as interactive cards.
# Create a self-built app on the Feishu open platform, grant it the
# `im:message` scope (add `im:chat:read` so the settings dialog can list the
# bot's groups), publish it and add the bot to every target group, then fill
# these in and recreate the stack (`docker compose -f docker-compose-light.yml
# up -d --no-deps superset-light superset-worker-light superset-worker-beat-light`).
# Empty credentials disable the channel; the briefing UI then explains that the
# app is not configured.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Use https://open.larksuite.com for the international (Lark) tenant.
FEISHU_API_BASE=https://open.feishu.cn
# Origin of the MUI frontend the card's "查看完整简报" button links back to.
BRIEFING_FRONTEND_BASE_URL=http://localhost:9000
# Tenant web host for browser links in Feishu cards, e.g. https://acme.feishu.cn
FEISHU_WEB_BASE=
