{
  "name": "superset",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev-server": "vite --host 0.0.0.0 --port 9000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
